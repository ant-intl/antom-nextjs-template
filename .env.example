# ============================================================
# Antom x Vercel Template - Environment Variables
# ============================================================
# Copy this file to `.env.local` for connected development.
# `npm run dev` opens a synthetic Airtable preview with no credentials needed.
# On Vercel: configured automatically via Deploy Button form,
# or manually under Project Settings -> Environment Variables.
# ============================================================


# --- 1. Antom Credentials (REQUIRED) ------------------------

# Your merchant Client ID from Antom Dashboard.
# Where: Antom Dashboard -> Developer -> Integration Settings
# Format: alphanumeric, ~16-32 chars
# Example: SANDBOX_5X8X9XXXXXXXXXXX
ANTOM_CLIENT_ID=

# Your merchant RSA2048 PRIVATE key (PKCS8, single line, no headers).
# WARNING: NEVER commit this. NEVER log this. NEVER expose to client.
# How to generate:
#   openssl genpkey -algorithm RSA -out priv.pem -pkeyopt rsa_keygen_bits:2048
#   awk 'NF{printf "%s",$0}' priv.pem | sed 's/-----[^-]*-----//g'
# Output is a SINGLE LINE base64 string -- paste it as-is.
ANTOM_PRIVATE_KEY=

# Antom platform PUBLIC key (for verifying API responses and webhooks).
# Where: Antom Dashboard -> Developer -> Key configuration -> Antom Public Key
# Format: single line base64, no PEM headers.
ANTOM_PUBLIC_KEY=


# --- 2. Antom Gateway (REQUIRED) ----------------------------

# Regional online-payment gateway ORIGIN. Pick the merchant's actual region.
#   Asia:                 https://open-sea-global.alipay.com (recommended)
#                         https://open-sea.alipay.com (alias)
#   Europe:               https://open-de-global.alipay.com
#   North America non-US: https://open-na-global.alipay.com (recommended)
#                         https://open-na.alipay.com (alias)
#   North America US:     https://open.antglobal-us.com
# See https://docs.antom.com/ac/ams/api . Do not append an API path here.
# Old open-eu-global/open-us-global/open-global examples are rejected.
ANTOM_GATEWAY_URL=https://open-sea-global.alipay.com


# --- 3. Runtime Mode (REQUIRED, exposed to client) ----------

# Antom environment: `sandbox` or `prod`.
# Used by both server (signing endpoint) and client (CKP SDK init).
# Server online Sandbox paths use /ams/sandbox/api/; production uses /ams/api/.
# Always use matching merchant credentials. Airtable supports sandbox only.
NEXT_PUBLIC_ANTOM_ENV=sandbox


# --- 4. Site URL (REQUIRED, exposed to client) --------------

# Public origin of your deployment.
# Local:   http://127.0.0.1:3000
# Vercel:  https://<your-project>.vercel.app  (or custom domain)
# Used to build:
#   - paymentRedirectUrl  ({SITE_URL}/result)
#   - paymentNotifyUrl    ({SITE_URL}/api/webhooks/antom)
# Optional Airtable flow requires your HTTPS origin (localhost is insufficient):
#   - paymentRedirectUrl  ({SITE_URL}/airtable?recordId=...)
#   - paymentNotifyUrl    ({SITE_URL}/api/airtable/webhooks/antom)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Live demo deployment: https://antom-payment-demo.vercel.app


# --- 5. Optional Overrides ----------------------------------

# Original storefront webhook path (default: /api/webhooks/antom).
# Does not override Airtable's separate /api/airtable/webhooks/antom endpoint.
# ANTOM_NOTIFY_PATH=/api/webhooks/antom

# Settlement currency (default: USD); must be supported by your merchant contract.
# Also used by the optional Airtable session request's settlementStrategy.
# ANTOM_DEFAULT_CURRENCY=USD


# --- 6. Optional Airtable Integration (SANDBOX ONLY) ---------
# Full setup: docs/airtable.md . Connected integration is disabled by default.
# Airtable page: / or /airtable. Original storefront: /store.
# One merchant + one Base per deployment. No publisher credentials are supplied.
# All AIRTABLE_* values are SERVER-ONLY. Never add NEXT_PUBLIC_ to these names.
AIRTABLE_ENABLED=false

# `npm run dev` defaults AIRTABLE_LOCAL_PREVIEW to true.
# Preview requires NODE_ENV=development and AIRTABLE_ENABLED not set to true.
# It uses synthetic data only: no API/database access, checkout link or payment.
# `npm run dev:connected` disables preview. Production always disables it.
# AIRTABLE_LOCAL_PREVIEW=true

# PAT with data.records:read and data.records:write, restricted to your own Base.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# Persistent PostgreSQL connection string with your provider's TLS settings.
# Migration: npm run airtable:migrate . It reads process env, NOT .env.local.
# Inject the same connection value securely; do not paste it into shell history.
AIRTABLE_DATABASE_URL=

# Two DIFFERENT random secrets, each at least 32 characters.
# Operator password is shared only with authorized merchant operators.
# It is NOT an Airtable password/OAuth login; operators can access all bound orders.
AIRTABLE_OPERATOR_PASSWORD=
AIRTABLE_SESSION_SECRET=

# Uppercase ISO currency codes, comma-separated (e.g. USD,EUR).
# Confirm merchant eligibility and each currency's amount units before enabling.
AIRTABLE_ALLOWED_CURRENCIES=

# Base editors author trusted prices in this version. Read the guide before true.
AIRTABLE_TRUST_BASE_EDITORS=false

# Exact verified Antom checkout hostnames, comma-separated.
# No scheme/path/port/wildcard; do not guess a public demo domain.
AIRTABLE_CHECKOUT_HOSTS=

# Also required: NEXT_PUBLIC_ANTOM_ENV=sandbox and a deployed HTTPS SITE_URL.
# Check both authorization and capture callback configuration in Antom Dashboard.
# A Dashboard capture URL overrides the API URL; see the guide before testing.
# Do not run original Demo and Airtable with a shared unverified merchant callback.
