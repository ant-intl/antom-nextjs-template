# ============================================================
# Antom x Vercel Template - Environment Variables
# ============================================================
# Copy this file to `.env.local` for local dev.
# On Vercel: configured automatically via Deploy Button form,
# or manually under Project Settings -> Environment Variables.
# ============================================================


# --- 1. Antom Credentials (REQUIRED) ------------------------

# Your merchant Client ID from Antom Dashboard.
# Where: Antom Dashboard -> Developer -> Integration Settings
# Format: alphanumeric, ~16-32 chars
# Example: SANDBOX_5X8X9XXXXXXXXXXX
ANTOM_CLIENT_ID=

# Your merchant RSA2048 PRIVATE key (PKCS8, single line, no headers).
# WARNING: NEVER commit this. NEVER log this. NEVER expose to client.
# How to generate:
#   openssl genpkey -algorithm RSA -out priv.pem -pkeyopt rsa_keygen_bits:2048
#   awk 'NF{printf "%s",$0}' priv.pem | sed 's/-----[^-]*-----//g'
# Output is a SINGLE LINE base64 string -- paste it as-is.
ANTOM_PRIVATE_KEY=

# Antom platform PUBLIC key (for verifying webhooks).
# Where: Antom Dashboard -> Developer -> Key configuration -> Antom Public Key
# Format: single line base64, no PEM headers.
ANTOM_PUBLIC_KEY=


# --- 2. Antom Gateway (REQUIRED) ----------------------------

# Regional gateway endpoint. Pick ONE based on your business region.
#   Asia (default for this template): https://open-sea-global.alipay.com
#   Europe:                           https://open-eu-global.alipay.com
#   Americas:                         https://open-us-global.alipay.com
#   Global Default:                   https://open-global.alipay.com
ANTOM_GATEWAY_URL=https://open-sea-global.alipay.com


# --- 3. Runtime Mode (REQUIRED, exposed to client) ----------

# Antom environment: `sandbox` or `prod`.
# Used by both server (signing endpoint) and client (CKP SDK init).
NEXT_PUBLIC_ANTOM_ENV=sandbox


# --- 4. Site URL (REQUIRED, exposed to client) --------------

# Public origin of your deployment.
# Local:   http://localhost:3000
# Vercel:  https://<your-project>.vercel.app  (or custom domain)
# Used to build:
#   - paymentRedirectUrl  ({SITE_URL}/result)
#   - paymentNotifyUrl    ({SITE_URL}/api/webhooks/antom)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- 5. Optional Overrides ----------------------------------

# Override webhook receiver path (default: /api/webhooks/antom)
# ANTOM_NOTIFY_PATH=/api/webhooks/antom

# Default settlement currency (default: USD)
# ANTOM_DEFAULT_CURRENCY=USD
